+from __future__ import annotations
+
+import asyncio
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from app.ai_director_game_master import (
+    GAME_MASTER_CONTRACT_VERSION,
+    GAME_MASTER_RUNTIME_ENABLED_DEFAULT,
+    big_job_packet,
+    chapter_packet,
+    consequence_recall_packet,
+    legendary_event_packet,
+    npc_story_packet,
+    world_story_packet,
+)
+from app.ai_director_game_master_integration import GAME_MASTER_FIELD_NAME, add_game_master_field
+from app.config import load_settings
+from app.services.ai_director_game_master import AIDirectorGameMaster
+
+
+def run(coro):
+    return asyncio.run(coro)
+
+
+class FakeProvider:
+    def __init__(self, payload=None, *, error: Exception | None = None):
+        self.payload = payload or {"title": "A Belvárosi trezor", "description": "A Belvárosi trezor ügy lezárása: Siker."}
+        self.error = error
+        self.calls = 0
+
+    async def generate_game_master(self, packet):
+        self.calls += 1
+        if self.error is not None:
+            raise self.error
+        return dict(self.payload)
+
+
+class FakeEmbed:
+    def __init__(self):
+        self.fields = []
+
+    def add_field(self, *, name, value, inline):
+        self.fields.append((name, value, inline))
+
+
+def big():
+    return big_job_packet(
+        target_name="Belvárosi trezor",
+        phase_label="Lezárt ügy",
+        approach_label="Csendes út",
+        route_label="Eredeti útvonal",
+        host_resolution="Siker",
+        consequence_note="A csapat az eredeti útvonalon maradt.",
+    )
+
+
+def _clean_ai_env(monkeypatch):
+    for name in (
+        "TEST_GUILD_ID",
+        "YORU_AI_DIRECTOR_PILOT_ENABLED",
+        "YORU_AI_DIRECTOR_CONTEXT_PILOT_ENABLED",
+        "YORU_AI_DIRECTOR_GAME_MASTER_PILOT_ENABLED",
+        "GROQ_API_KEY",
+    ):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setenv("DISCORD_TOKEN", "test-token")
+
+
+def test_version_is_v38313():
+    assert Path("VERSION").read_text(encoding="utf-8").strip() == "3.83.13"
+
+
+def test_contract_stays_reviewed_surface_v6():
+    assert GAME_MASTER_CONTRACT_VERSION == "tier3-game-master-surface-v6"
+
+
+def test_runtime_default_stays_off():
+    assert GAME_MASTER_RUNTIME_ENABLED_DEFAULT is False
+
+
+def test_config_default_game_master_pilot_off(monkeypatch):
+    _clean_ai_env(monkeypatch)
+    settings = load_settings()
+    assert settings.ai_director_game_master_pilot_enabled is False
+
+
+def test_config_game_master_requires_master_pilot(monkeypatch):
+    _clean_ai_env(monkeypatch)
+    monkeypatch.setenv("TEST_GUILD_ID", "123456789")
+    monkeypatch.setenv("YORU_AI_DIRECTOR_GAME_MASTER_PILOT_ENABLED", "true")
+    monkeypatch.setenv("GROQ_API_KEY", "secret")
+    with pytest.raises(RuntimeError, match="Tier 3 Game Master Pilot"):
+        load_settings()
+
+
+def test_config_game_master_requires_test_guild(monkeypatch):
+    _clean_ai_env(monkeypatch)
+    monkeypatch.setenv("YORU_AI_DIRECTOR_PILOT_ENABLED", "true")
+    monkeypatch.setenv("YORU_AI_DIRECTOR_GAME_MASTER_PILOT_ENABLED", "true")
+    monkeypatch.setenv("GROQ_API_KEY", "secret")
+    with pytest.raises(RuntimeError, match="TEST_GUILD_ID"):
+        load_settings()
+
+
+def test_config_game_master_requires_groq_key(monkeypatch):
+    _clean_ai_env(monkeypatch)
+    monkeypatch.setenv("TEST_GUILD_ID", "123456789")
+    monkeypatch.setenv("YORU_AI_DIRECTOR_PILOT_ENABLED", "true")
+    monkeypatch.setenv("YORU_AI_DIRECTOR_GAME_MASTER_PILOT_ENABLED", "true")
+    with pytest.raises(RuntimeError, match="GROQ_API_KEY"):
+        load_settings()
+
+
+def test_config_game_master_valid_test_guild_opt_in(monkeypatch):
+    _clean_ai_env(monkeypatch)
+    monkeypatch.setenv("TEST_GUILD_ID", "123456789")
+    monkeypatch.setenv("YORU_AI_DIRECTOR_PILOT_ENABLED", "true")
+    monkeypatch.setenv("YORU_AI_DIRECTOR_GAME_MASTER_PILOT_ENABLED", "true")
+    monkeypatch.setenv("GROQ_API_KEY", "secret")
+    settings = load_settings()
+    assert settings.ai_director_game_master_pilot_enabled is True
+    assert settings.test_guild_id == 123456789
+    assert "secret" not in repr(settings)
+
+
+def test_service_disabled_outside_pilot():
+    gm = AIDirectorGameMaster(provider=FakeProvider(), enabled=False, test_guild_id=10)
+    assert run(gm.surface(10, big())) is None
+
+
+def test_service_wrong_guild_is_none():
+    provider = FakeProvider()
+    gm = AIDirectorGameMaster(provider=provider, enabled=True, test_guild_id=10)
+    assert run(gm.surface(11, big())) is None
+    assert provider.calls == 0
+
+
+def test_service_missing_provider_falls_back():
+    gm = AIDirectorGameMaster(provider=None, enabled=True, test_guild_id=10)
+    result = run(gm.surface(10, big()))
+    assert result is not None
+    assert result.source == "deterministic_scenario_v2_fallback"
+
+
+def test_service_provider_error_falls_back():
+    gm = AIDirectorGameMaster(provider=FakeProvider(error=RuntimeError("offline")), enabled=True, test_guild_id=10)
+    result = run(gm.surface(10, big()))
+    assert result is not None
+    assert result.source == "deterministic_scenario_v2_fallback"
+
+
+def test_service_valid_ai_surface_is_cached():
+    provider = FakeProvider()
+    gm = AIDirectorGameMaster(provider=provider, enabled=True, test_guild_id=10, cache_ttl_seconds=300)
+    first = run(gm.surface(10, big()))
+    second = run(gm.surface(10, big()))
+    assert first is not None and first.source == "ai_game_master"
+    assert second is not None and second.source == "ai_game_master_cache"
+    assert provider.calls == 1
+
