+def test_field_value_is_bounded():
+    gm = AIDirectorGameMaster(provider=None, enabled=True, test_guild_id=10)
+    value = run(gm.field_value(10, big()))
+    assert value is not None
+    assert len(value) <= 1024
+
+
+def test_integration_adds_one_named_field():
+    gm = AIDirectorGameMaster(provider=None, enabled=True, test_guild_id=10)
+    bot = SimpleNamespace(ai_director_game_master=gm)
+    embed = FakeEmbed()
+    assert run(add_game_master_field(bot, embed, 10, big)) is True
+    assert len(embed.fields) == 1
+    assert embed.fields[0][0] == GAME_MASTER_FIELD_NAME
+    assert embed.fields[0][2] is False
+
+
+def test_integration_wrong_guild_adds_nothing():
+    gm = AIDirectorGameMaster(provider=None, enabled=True, test_guild_id=10)
+    bot = SimpleNamespace(ai_director_game_master=gm)
+    embed = FakeEmbed()
+    assert run(add_game_master_field(bot, embed, 11, big)) is False
+    assert embed.fields == []
