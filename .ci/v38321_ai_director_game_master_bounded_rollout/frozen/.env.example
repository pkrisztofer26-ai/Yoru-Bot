# ============================================================
# YORU v3.83.21 - PEBBLEHOST LIVE + W22.8 BOUNDED RARE-CONTENT GATE
# Copy only the keys you actually use into PebbleHost Variables/.env.
# NEVER commit or share the real .env file.
# ============================================================

# --- REQUIRED: Discord ---
DISCORD_TOKEN=IDE_JON_A_LIVE_YORU_BOT_TOKEN

# --- REQUIRED: production MariaDB/MySQL ---
YORU_DB_BACKEND=mysql
MYSQL_HOST=IDE_JON_A_DB_HOST
MYSQL_PORT=3306
MYSQL_USER=IDE_JON_A_DB_USER
MYSQL_PASSWORD=IDE_JON_A_DB_PASSWORD
MYSQL_DATABASE=IDE_JON_A_DB_NAME
# Keep the value that already works on your PebbleHost DB endpoint.
MYSQL_SSL_DISABLED=true

# --- W22.7.1 AI PILOT ---
# IMPORTANT: leave TEST_GUILD_ID EMPTY on the live bot.
# TEST_GUILD_ID controls Discord slash-command DEV sync, not the AI pilot.
TEST_GUILD_ID=

# Put the separate private Discord test-server ID here.
YORU_AI_PILOT_GUILD_ID=IDE_JON_A_KULON_TESZT_SZERVER_ID
YORU_AI_DIRECTOR_PILOT_ENABLED=true
YORU_AI_DIRECTOR_CONTEXT_PILOT_ENABLED=false
YORU_AI_DIRECTOR_GAME_MASTER_PILOT_ENABLED=true
GROQ_API_KEY=IDE_JON_A_GROQ_API_KEY


# --- W22.8 BROADER RARE-CONTENT ROLLOUT ---
# DEFAULT/SAFE STATE: keep OFF until the W22.8 deploy gate is explicitly approved.
YORU_AI_DIRECTOR_GAME_MASTER_ROLLOUT_ENABLED=false
# One explicit non-test guild only. Leave empty while rollout is OFF.
YORU_AI_GAME_MASTER_ROLLOUT_GUILD_ID=
# 0 while OFF. When explicitly approved: 1-10 only; code hard-caps at 10%.
YORU_AI_GAME_MASTER_ROLLOUT_PERCENT=0
# Locked families are code-owned: world_story + legendary_event only.
# Cohort is deterministic from packet digest; no user ID is used.
# Runtime provider cap: 4 rollout attempts/minute.

# --- MUSIC: required only if Yoru music/Lavalink is used ---
LAVALINK_URI=IDE_JON_A_LAVALINK_URI
LAVALINK_PASSWORD=IDE_JON_A_LAVALINK_PASSWORD
LAVALINK_IDENTIFIER=yoru-main
# Optional; normally ffmpeg is found automatically.
# FFMPEG_EXECUTABLE=ffmpeg

# --- OPTIONAL install-level event fallbacks ---
# Most live event values are DB-backed /settings values; omit these unless you intentionally override fallback defaults.
# EVENT_CHANNEL_ID=
# AUTO_EVENTS_ENABLED=true
# AUTO_EVENT_MIN_HOURS=
# AUTO_EVENT_MAX_HOURS=
# AUTO_JOIN_SECONDS=
# AUTO_BOMB_ROUND_SECONDS=
# AUTO_EVENT_ACTIVITY_MESSAGES=
# AUTO_EVENT_ACTIVITY_WINDOW_MINUTES=
# AUTO_EVENT_ACTIVITY_MIN_USERS=
# AUTO_EVENT_ACTIVITY_USER_COOLDOWN_SECONDS=

# --- OPTIONAL DB tuning: normally omit and keep code defaults ---
# MYSQL_POOL_SIZE=8
# MYSQL_POOL_NAME=yoru-main
# MYSQL_CONNECT_TIMEOUT_SECONDS=10
# MYSQL_POOL_ACQUIRE_TIMEOUT_SECONDS=10
# MYSQL_LEGACY_WRITE_LOCK=true
# MYSQL_LEGACY_LOCK_TIMEOUT=15
# MYSQL_SLOW_QUERY_MS=250

# --- OPTIONAL feature fallback ---
# YORU_CHARACTER_GATE_ENABLED=true
