+    tip = tips_context_packet(topic="Eltűnt szállítmány", source_label="üzleti kapcsolat", certainty="ellenőrizetlen jelzés")
+    merged = " ".join((housing.fallback_description, npc.fallback_description, tip.fallback_description)).casefold()
+    assert "otthonvárosban helyezkedik el" not in merged
+    assert "ügyben áll" not in merged
