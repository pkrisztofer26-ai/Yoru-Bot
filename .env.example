DISCORD_TOKEN=IDE_JON_A_BOT_TOKEN
TEST_GUILD_ID=IDE_JON_A_SZERVER_ID

# Auto event csatorna / időzítés. A PÉNZ balance (starter, reward, entry fee,
# shop, work, crime stb.) v3.5-től kizárólag app/economy_config.py-ban van.
EVENT_CHANNEL_ID=IDE_JON_A_CSATORNA_ID
AUTO_EVENTS_ENABLED=true
AUTO_EVENT_MIN_HOURS=0.25
AUTO_EVENT_MAX_HOURS=1.5
AUTO_JOIN_SECONDS=30
AUTO_BOMB_ROUND_SECONDS=15

# Auto event activity gate: csak aktív chatben indul event.
AUTO_EVENT_ACTIVITY_MESSAGES=20
AUTO_EVENT_ACTIVITY_WINDOW_MINUTES=30
AUTO_EVENT_ACTIVITY_MIN_USERS=4
AUTO_EVENT_ACTIVITY_USER_COOLDOWN_SECONDS=5

# Music — v3.17.2-től a Spotify alapértelmezett backend Python-only Fast Resolver.
# Lavalink NEM szükséges. Az alábbi LAVALINK_* mezők csak opcionális kompatibilitásra
# maradtak; hagyd őket üresen PebbleHost Python hostingon.
LAVALINK_URI=
LAVALINK_PASSWORD=CHANGE_ME_LAVALINK_PASSWORD
LAVALINK_IDENTIFIER=yoru-main

# Opcionális Spotify API credentialök jövőbeli/alternatív resolverhez; a jelenlegi
# Fast Resolver spotDL-lel ezek nélkül is működik. Ne Discord /settings-ben tárold.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

